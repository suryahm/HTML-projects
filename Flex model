<!DOCTYPE html>
<html>
<head>
  <title>Flexbox Tasks</title>

  <style>
    body {
      font-family: Arial, sans-serif;
    }

    /* Task 1: center a box horizontally and vertically */
    .center-container {
      display: flex;
      justify-content: center;   /* horizontal */
      align-items: center;       /* vertical */
      height: 100vh;             /* full page height */
      background-color: #eee;
    }

    .center-box {
      width: 150px;
      height: 150px;
      background-color: tomato;
    }

    /* Task 2: horizontal navbar */
    .navbar-row {
      display: flex;
      flex-direction: row;
      justify-content: space-evenly;
      background-color: #333;
      padding: 15px;
    }

    .navbar-row a {
      color: white;
      text-decoration: none;
    }

    /* Task 3: vertical navbar */
    .navbar-column {
      display: flex;
      flex-direction: column;
      justify-content: space-evenly;
      width: 150px;
      height: 300px;
      background-color: #333;
      padding: 15px;
    }

    .navbar-column a {
      color: white;
      text-decoration: none;
    }

    /* Task 4: cards in a row with equal spacing */
    .card-container {
      display: flex;
      justify-content: space-between;
    }

    .card {
      width: 30%;
      padding: 20px;
      border: 1px solid #999;
      background-color: #f5f5f5;
    }

    /* Task 5: align boxes at the bottom */
    .bottom-container {
      display: flex;
      align-items: flex-end;
      height: 250px;
      border: 2px solid black;
    }

    .bottom-box {
      width: 100px;
      margin: 10px;
      background-color: lightgreen;
    }

    /* Task 6: row to column on small screens */
    .responsive-container {
      display: flex;
      flex-direction: row;
    }

    .responsive-box {
      flex: 1;
      padding: 30px;
      margin: 5px;
      background-color: lightblue;
      text-align: center;
    }

    @media (max-width: 600px) {
      .responsive-container {
        flex-direction: column;
      }
    }

    /* Task 7: image gallery */
    .gallery {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .gallery img {
      width: 200px;
      height: 150px;
    }
  </style>
</head>
<body>

  <h1>Flexbox Tasks</h1>

  <h2>1. Center a Box</h2>
  <div class="center-container">
    <div class="center-box"></div>
  </div>

  <h2>2. Horizontal Navigation Bar</h2>
  <div class="navbar-row">
    <a href="#">Home</a>
    <a href="#">About</a>
    <a href="#">Services</a>
    <a href="#">Blog</a>
    <a href="#">Contact</a>
  </div>

  <h2>3. Vertical Navigation Bar</h2>
  <div class="navbar-column">
    <a href="#">Home</a>
    <a href="#">About</a>
    <a href="#">Services</a>
    <a href="#">Blog</a>
    <a href="#">Contact</a>
  </div>

  <h2>4. Card Layout</h2>
  <div class="card-container">
    <div class="card">
      <h3>Card 1</h3>
      <p>This is the first card.</p>
    </div>
    <div class="card">
      <h3>Card 2</h3>
      <p>This is the second card.</p>
    </div>
    <div class="card">
      <h3>Card 3</h3>
      <p>This is the third card.</p>
    </div>
  </div>

  <h2>5. Align Items at the Bottom</h2>
  <div class="bottom-container">
    <div class="bottom-box" style="height: 50px;">Box 1</div>
    <div class="bottom-box" style="height: 100px;">Box 2</div>
    <div class="bottom-box" style="height: 150px;">Box 3</div>
    <div class="bottom-box" style="height: 80px;">Box 4</div>
  </div>

  <h2>6. Responsive Row to Column</h2>
  <div class="responsive-container">
    <div class="responsive-box">Box 1</div>
    <div class="responsive-box">Box 2</div>
    <div class="responsive-box">Box 3</div>
  </div>

  <h2>7. Image Gallery</h2>
  <div class="gallery">
    <img src="https://picsum.photos/id/10/400/300" alt="image 1">
    <img src="https://picsum.photos/id/20/400/300" alt="image 2">
    <img src="https://picsum.photos/id/30/400/300" alt="image 3">
    <img src="https://picsum.photos/id/40/400/300" alt="image 4">
    <img src="https://picsum.photos/id/50/400/300" alt="image 5">
    <img src="https://picsum.photos/id/60/400/300" alt="image 6">
  </div>

</body>
</html>
