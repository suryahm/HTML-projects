<!DOCTYPE html>
<html>
<head>
  <title>CSS Grid Tasks</title>

  <style>
    body {
      font-family: Arial, sans-serif;
    }

    /* Task 1: basic 3x2 grid */
    .grid1 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: repeat(2, 1fr);
      gap: 10px;
      height: 200px;
    }

    .grid1 div {
      background-color: lightblue;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    /* Task 2: website page layout */
    .layout {
      display: grid;
      grid-template-columns: 200px 1fr;
      grid-template-areas:
        "header header"
        "sidebar main"
        "footer footer";
      gap: 10px;
    }

    .header  { grid-area: header;  background-color: #333; color: white; padding: 20px; }
    .sidebar { grid-area: sidebar; background-color: #ddd; padding: 20px; }
    .main    { grid-area: main;    background-color: #f5f5f5; padding: 20px; min-height: 150px; }
    .footer  { grid-area: footer;  background-color: #333; color: white; padding: 20px; }

    /* Task 3: responsive card grid */
    .card-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 15px;
    }

    .card {
      background-color: #f5f5f5;
      border: 1px solid #999;
      padding: 20px;
    }

    /* Task 4: image gallery */
    .gallery {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 120px;
      gap: 10px;
    }

    .gallery img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .wide { grid-column: span 2; }
    .tall { grid-row: span 2; }
    .big  { grid-column: span 2; grid-row: span 2; }

    /* Task 5: dashboard layout */
    .dashboard {
      display: grid;
      grid-template-columns: 200px 1fr;
      grid-template-rows: 60px 1fr;
      grid-template-areas:
        "sidebar topbar"
        "sidebar content";
      height: 450px;
    }

    .dash-sidebar {
      grid-area: sidebar;
      background-color: #2c3e50;
      color: white;
      padding: 20px;
    }

    .topbar {
      grid-area: topbar;
      background-color: #ecf0f1;
      padding: 20px;
    }

    .content {
      grid-area: content;
      padding: 20px;
      display: grid;
      grid-template-rows: 100px 1fr;
      gap: 15px;
    }

    /* nested grid for the stats widgets */
    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 15px;
    }

    .widget {
      background-color: lightgreen;
      padding: 20px;
    }

    .chart-area {
      background-color: #f5f5f5;
      padding: 20px;
    }
  </style>
</head>
<body>

  <h1>CSS Grid Tasks</h1>

  <h2>Task 1: Basic Grid Layout</h2>
  <div class="grid1">
    <div>1</div>
    <div>2</div>
    <div>3</div>
    <div>4</div>
    <div>5</div>
    <div>6</div>
  </div>

  <h2>Task 2: Website Page Layout</h2>
  <div class="layout">
    <div class="header">Header</div>
    <div class="sidebar">Sidebar</div>
    <div class="main">Main Content</div>
    <div class="footer">Footer</div>
  </div>

  <h2>Task 3: Card Grid (Responsive)</h2>
  <div class="card-grid">
    <div class="card">Card 1</div>
    <div class="card">Card 2</div>
    <div class="card">Card 3</div>
    <div class="card">Card 4</div>
    <div class="card">Card 5</div>
    <div class="card">Card 6</div>
    <div class="card">Card 7</div>
    <div class="card">Card 8</div>
  </div>

  <h2>Task 4: Image Gallery</h2>
  <div class="gallery">
    <img class="big"  src="https://picsum.photos/id/10/600/600" alt="image 1">
    <img              src="https://picsum.photos/id/20/300/300" alt="image 2">
    <img              src="https://picsum.photos/id/30/300/300" alt="image 3">
    <img class="wide" src="https://picsum.photos/id/40/600/300" alt="image 4">
    <img class="tall" src="https://picsum.photos/id/50/300/600" alt="image 5">
    <img              src="https://picsum.photos/id/60/300/300" alt="image 6">
    <img              src="https://picsum.photos/id/70/300/300" alt="image 7">
    <img class="wide" src="https://picsum.photos/id/80/600/300" alt="image 8">
  </div>

  <h2>Task 5: Dashboard Layout</h2>
  <div class="dashboard">
    <div class="dash-sidebar">
      <h3>Admin</h3>
      <p>Dashboard</p>
      <p>Users</p>
      <p>Orders</p>
      <p>Settings</p>
    </div>

    <div class="topbar">Top Navigation Bar</div>

    <div class="content">
      <div class="stats">
        <div class="widget">Users: 120</div>
        <div class="widget">Orders: 45</div>
        <div class="widget">Revenue: Rs3000</div>
      </div>
      <div class="chart-area">Main Content Area</div>
    </div>
  </div>

</body>
</html>
